DB_HOST=db
DB_PORT=5432
DB_USER=trader
DB_PASSWORD=bitte_aendern
DB_NAME=sentiment_trader
POLL_INTERVAL=60
SENTIMENT_INTERVAL=30
USER_AGENT=SentimentTraderBot/0.1
# Bot verbindet sich zum dockerisierten Gateway (Service ib-gateway), Paper-Port 4004
IBKR_HOST=ib-gateway
IBKR_PORT=4004
IBKR_CLIENT_ID=1

# --- IB Gateway Auto-Login (dockerisiert via gnzsnz/ib-gateway) ---
TWS_USERID=dein_ib_benutzername
TWS_PASSWORD=dein_ib_passwort
TRADING_MODE=paper
READ_ONLY_API=no
VNC_SERVER_PASSWORD=

# --- Risk-Management / Kill-Switch ---
# Not-Aus: auf "no" setzen, um JEDE Order zu stoppen (Container läuft weiter)
TRADING_ENABLED=yes
MAX_OPEN_POSITIONS=10
MAX_DAILY_LOSS=0.05      # 5% Tages-Verlustlimit; 0 = aus
STOP_LOSS_PCT=0.08       # -8% Stop-Loss je Kauf; 0 = aus
TAKE_PROFIT_PCT=0.15     # +15% Take-Profit je Kauf; 0 = aus

# --- Strategie-Feinschliff ---
# Pufferzone um den 20-Tage-SMA gegen Whipsaw (Hysterese). 0.02 = ±2%.
# Größer = ruhiger/weniger Trades, kleiner = reaktiver. 0 = altes Verhalten.
SMA_BAND=0.02
# Prüf-Takt der Signal-Engine in Minuten (Einstiege/Ausstiege). 15 = alle 15 Min.
# Kleiner = schnellere Reaktion, aber mehr Fehlsignale/Gebühren/yfinance-Last.
CYCLE_MINUTES=15

# --- Gemini Deep-Dive (Phase 2, qualitatives Research; optional) ---
# Kostenlosen Key bei Google AI Studio holen: https://aistudio.google.com/apikey
# Leer = Deep-Dive-Funktion ist inaktiv (Bot läuft normal weiter).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
